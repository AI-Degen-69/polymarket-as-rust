# ==============================================================================
# NEX SANDBOX (Amoy 80002)
# ==============================================================================

## === Endpoints & Network ===
NEX_CLOB_URL=https://nex.preprod.defi.euw2.polymarket.sh
NEX_WS_URL=wss://nex-ws.preprod.defi.euw2.polymarket.sh
GAMMA_PREPROD_URL=https://gamma-api-preprod.polymarket.dev
NEX_RELAYER_URL=https://relayer-preprod.polymarket.dev
NEX_CHAIN_ID=80002
NEX_INGRESS_IP=51.24.102.79
# Operator's allowlisted source IPv4 (/32) for the NEX public route.
NEX_ALLOWLISTED_EGRESS_IP=
# Sockets already used by other clients behind this NAT (counts against caps).
NEX_SHARED_NAT_SOCKETS=0
# Amoy RPC for approval transactions. Contains a private key: keep it empty here.
AMOY_RPC_URL=

## === Contracts & Wallet (EOA) ===
# Amoy exchange contracts published in the NEX onboarding example.
NEX_EXCHANGE_ADDRESS=0xe3333700cA9d93003F00f0F71f8515005F6c00Aa
NEX_POSITION_MANAGER=0x006F54F7f9A22e0000CC2AB60031000000ae9fEF
# eoa or deposit-wallet; Safe/Proxy are unsupported in the sandbox.
NEX_WALLET_MODE=eoa
# Public Amoy EOA you control. Never a Polymarket Deposit/Proxy address.
NEX_TRADING_ADDRESS=
# Amoy EOA signing key (needs Amoy POL for approvals).
POLYMARKET_PRIVATE_KEY=

## === Auth (Gamma Edge & CLOB L2) ===
# Gamma preprod edge credentials (discovery only, separate from sandbox trading).
GAMMA_CLIENT_ID=
GAMMA_CLIENT_SECRET=
# Sandbox L2 creds. Generate with scripts/nex_create_l2_key.py --nonce 0
# (fallback: --derive). These are NOT 1Password Builder Auth credentials.
NEX_API_KEY=
NEX_API_SECRET=
NEX_API_PASSPHRASE=

# ==============================================================================
# POLYMARKET MAINNET / PRODUCTION (Ignored by NEX Sandbox)
# ==============================================================================

## === Mainnet Wallet & CLOB Auth ===
# 0 = EOA, 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE, 3 = POLY_1271 (Deposit Wallet)
POLY_SIG_TYPE=3
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_SIGNER_ADDRESS=
SIGNER_SECRET_KEY=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

## === Mainnet Relayer & Optional Feeds ===
GASLESS_RELAYER_ENABLED=true
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/submit
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLYBOLT_ENABLED=false
# Optional paid oracle feed. Unused by default: the bot computes a local 60s TWAP from Binance.
CHAINLINK_API_KEY=

# ==============================================================================
# BOT PARAMETERS (Engine, Risk & Strategy)
# ==============================================================================

## === Execution & Runtime Mode ===
EXECUTION_MODE=paper
DRY_RUN=true

## === Engine, Risk & Strategy Tuning ===
ENGINE_GAMMA=0.15
MAX_NOTIONAL_PER_LEG_USD=50.0
BASE_ORDER_SIZE_SHARES=20
MIN_COMBINED_SPREAD_USD=0.02
MAX_COMBINED_BID_USD=0.98
HYSTERESIS_TICK_BUFFER=0.25
VARIANCE_MODE=binary-cara
KAPPA_MODE=trade-normalized
SG_MODE=causal
INCLUDE_VARIANCE_SPREAD=true
CLOCK_DRIFT_MAX_MS=1000
